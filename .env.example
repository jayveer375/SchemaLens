# ── Copy this file to .env and fill in the values ──────────────────────────
# cp .env.example .env

# Mistral AI API Key (get from https://console.mistral.ai)
MISTRAL_API_KEY=your_mistral_api_key_here

# Google OAuth Client ID (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id_here

# Neon PostgreSQL Database URL (shared team database)
# Ask the project admin for the actual credentials
DATABASE_URL=postgresql://username:password@host/database?sslmode=require

# SMTP Configuration for sending OTP emails
# For Gmail: Use your Gmail address and App Password (not regular password)
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here